{
  "name": "file-any-transfer",
  "version": "1.0.0",
  "description": "Convert 14 file formats locally in your browser: Markdown, Word, PDF, Excel, CSV, JSON, HTML, images. Batch, offline, no uploads.",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "package": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:style": "stylelint \"assets/**/*.css\" \"{components,entrypoints}/**/*.vue\"",
    "lint:all": "pnpm typecheck && pnpm lint && pnpm lint:style",
    "fix:all": "eslint . --fix && stylelint --fix \"assets/**/*.css\" \"{components,entrypoints}/**/*.vue\" && prettier --write .",
    "test:e2e": "pnpm build && node scripts/e2e-test.mjs",
    "assets:capture": "node scripts/capture-store-assets.mjs",
    "promo:wechat": "node scripts/render-wechat-html.mjs docs/promo/wechat-article.md"
  },
  "keywords": [
    "chrome-extension",
    "file-converter",
    "format-conversion",
    "offline",
    "privacy",
    "markdown",
    "docx",
    "pdf",
    "xlsx",
    "csv",
    "json",
    "html",
    "image-conversion",
    "batch-conversion"
  ],
  "author": "",
  "displayName": "File Any Transfer",
  "license": "ISC",
  "packageManager": "pnpm@10.12.1",
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "dompurify": "^3.4.12",
    "element-plus": "^2.14.3",
    "fflate": "^0.8.3",
    "file-saver": "^2.0.5",
    "html-docx-js-typescript": "^0.1.5",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "mammoth": "^1.12.0",
    "marked": "^18.0.7",
    "pdfjs-dist": "^6.2.108",
    "turndown": "^7.2.4",
    "vue": "^3.5.40",
    "xlsx": "^0.18.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "lmdb",
      "msgpackr-extract",
      "sharp"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^26.1.2",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@wxt-dev/module-vue": "^1.0.3",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "playwright": "^1.62.1",
    "postcss-html": "^1.8.1",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.8",
    "wxt": "^0.21.2"
  }
}
